<script>
(function(){
    const source = document.getElementById('cartCountBadge');
    const target = document.getElementById('mobileCartCount');
    if(!source || !target) return;

    function sync(){
        target.textContent = source.textContent;
        target.style.display = source.style.display;
    }

    sync();
    new MutationObserver(sync).observe(source, {
        childList: true,
        characterData: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style']
    });
})();
</script>
<script src="settings-loader.js"></script>

<!-- ============ ربط الإعدادات بالـ Structured Data (SEO) ============ -->
<script>
(function () {
  "use strict";

  /* بيسمع نفس الحدث اللي settings-loader.js بيبعته بعد ما يجيب /api/settings
     مفيش fetch تاني هنا، بنستخدم البيانات اللي وصلت خلاص */
  document.addEventListener("rw:settings-loaded", function (e) {
    updateJsonLd(e.detail || window.RW_SETTINGS);
  });

  function updateJsonLd(s) {
    if (!s) return;

    const script = document.getElementById("ldBusiness");
    if (!script) return;

    let ld;
    try {
      ld = JSON.parse(script.textContent);
    } catch (err) {
      return;
    }

    if (s.siteName) ld.name = s.siteName;
    if (s.siteNameEn) ld.alternateName = s.siteNameEn;

    if (s.phoneIntl) ld.telephone = s.phoneIntl;
    else if (s.phone) ld.telephone = s.phone;

    if (s.email) ld.email = s.email;

    if (s.address) {
      ld.address = ld.address || { "@type": "PostalAddress" };
      ld.address.addressLocality = s.address;
      ld.address.addressCountry = "EG";
    }

    const social = [];
    if (s.facebook) social.push(s.facebook);
    if (s.instagram) social.push(s.instagram);
    if (s.twitter) social.push(s.twitter);
    if (s.linkedin) social.push(s.linkedin);
    if (social.length) ld.sameAs = social;

    if (s.logo) {
      const logoUrl = resolveImage(s.logo);
      ld.logo = logoUrl;
      ld.image = logoUrl;
    }

    script.textContent = JSON.stringify(ld);
  }

  function resolveImage(path) {
    const API_BASE = window.RW_API_BASE || "";
    if (!path) return "";
    if (/^https?:\/\//i.test(path)) return path;
    return API_BASE + "/uploads/" + path.replace(/^\/?(uploads\/)?/, "");
  }
})();
</script>
</body>
</html>
