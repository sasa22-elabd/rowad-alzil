    <script type="application/ld+json" id="ldBusiness">
    {
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "رواد الظل",
      "alternateName": "Road Alzill",
      "url": "https://rowadalthil.com/",
      "logo": "https://rowadalthil.com/images/logo.png",
      "image": "https://rowadalthil.com/images/og-cover.jpg",
      "description": "شركة متخصصة في تصنيع وتركيب المظلات، السواتر، الأثاث المعدني، وأعمال الكريتال والفورجيه والمنشآت المعدنية في مصر.",
      "telephone": "+201000000000",
      "email": "info@roadalzill.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "القاهرة",
        "addressCountry": "EG"
      },
      "areaServed": { "@type": "Country", "name": "Egypt" },
      "sameAs": [],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "خدمات رواد الظل",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "أنظمة التظليل الحديثة (شماسي)", "url": "https://rowadalthil.com/shamasy.html" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "السواتر القماشية والإنشائية", "url": "https://rowadalthil.com/sawatir.html" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "الأثاث المعدني العصري", "url": "https://rowadalthil.com/athath.html" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "أعمال الكريتال والفورجيه", "url": "https://rowadalthil.com/kretal.html" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "المنشآت المعدنية", "url": "https://rowadalthil.com/manshaat.html" } }
        ]
      }
    }
    </script>

    <!-- ============ Structured Data: الموقع نفسه ============ -->
