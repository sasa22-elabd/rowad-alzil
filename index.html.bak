<!-- =====================================================
     HERO
===================================================== -->

<main>

<section class="hero-section">

    <!-- SLIDES BACKGROUND -->
    <div class="hero-slides" id="heroSlides"></div>


    <!-- DARK OVERLAY -->
    <div class="hero-overlay"></div>


    <!-- HERO CONTENT -->
    <div class="hero-content">

        <div class="hero-right">

            <!-- SMALL LABEL -->
            <div class="hero-label">
                <span class="label-icon">
                    <i class="fa-solid fa-circle-arrow-left"></i>
                </span>

                <span id="heroLabel">
                    اقرأ المزيد
                </span>
            </div>


            <!-- TITLE -->
            <h1 id="heroTitle">
                نحو هياكل معدنية متينة
                <br>
                تصنع المستقبل
            </h1>


            <!-- DESCRIPTION -->
            <p id="heroDescription">
                في رواد الظل نقدم حلولًا معدنية متكاملة، تجمع بين القوة
                والدقة والجودة، من التصميم وحتى التنفيذ لتلبية مختلف
                احتياجات المشاريع.
            </p>


            <!-- CTA -->
            <a href="services.html" class="hero-button">

                <span class="button-icon">
                    <i class="fa-solid fa-arrow-up-left"></i>
                </span>

                <span>
                    شاهد خدماتنا
                </span>

            </a>

        </div>


        <!-- VIDEO CARD -->
        <div class="hero-video-card">

            <button class="video-preview" id="videoOpen">

                <img
                    id="videoThumbnail"
                    src="images/video-1.jpg"
                    alt="مشاهدة الفيديو"
                >

                <span class="play-button">
                    <i class="fa-solid fa-play"></i>
                </span>

            </button>


            <div class="video-info">

                <p id="videoText">
                    نقدم حلولًا متكاملة تساعد الشركات
                    على بناء حضور قوي واحترافي.
                </p>

            </div>


            <div class="slide-counter">

                <span id="currentSlide">
                    01
                </span>

                <b>/</b>

                <span id="totalSlides">
                    06
                </span>

            </div>

        </div>

    </div>


    <!-- SOCIAL -->
    <div class="hero-social">

        <a href="#" data-settings-href="link:instagram" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
        </a>

        <a href="#" data-settings-href="link:facebook" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f"></i>
        </a>

    </div>


    <!-- SLIDER ARROWS -->
    <div class="slider-controls">

        <button id="prevSlide" aria-label="السابق">
            <i class="fa-solid fa-chevron-right"></i>
        </button>

        <button id="nextSlide" aria-label="التالي">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

    </div>


    <!-- DOTS -->
    <div class="hero-dots" id="heroDots"></div>

</section>

</main>



