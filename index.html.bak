    <div class="work-sections-header">

        <div class="work-section-badge">
            <span></span>
            مجالات أعمالنا
            <span></span>
        </div>

        <h2>
            حلول معدنية
            <strong>بكل التفاصيل</strong>
        </h2>

        <p>
            استكشف مجموعة من أعمالنا وتخصصاتنا في تنفيذ وتصنيع
            المنتجات والهياكل المعدنية بأعلى مستوى من الجودة والدقة.
        </p>

    </div>


    <div class="work-sections-grid" id="workSectionsGrid">

        <!-- يتم تحميل الكروت من لوحة التحكم -->

    </div>

</section>

<script>
    document.addEventListener(
    "DOMContentLoaded",
    loadWorkSections
);


async function loadWorkSections() {

    const grid =
        document.getElementById("workSectionsGrid");

    if (!grid) return;


    grid.innerHTML = `
        <div class="work-sections-loading">
            جاري تحميل الأقسام...
        </div>
    `;


    try {

        const response =
            await fetch("/api/work-sections");


        if (!response.ok) {

            throw new Error(
                "Failed to load work sections"
            );

        }


        const result =
            await response.json();


        const sections =
            result.data || result.sections || [];


        if (!sections.length) {

            grid.innerHTML = "";

            return;
        }


        sections.sort(
            (a, b) =>
                (a.order || 0) -
                (b.order || 0)
        );


        grid.innerHTML =
            sections.map(
                (section, index) => {

                    return `

                        <a
                            href="/work/${encodeURIComponent(section.slug)}"
                            class="work-section-card"
                        >

                            <img
                                src="${escapeHtml(
                                    section.image ||
                                    "/images/default.jpg"
                                )}"
                                alt="${escapeHtml(
                                    section.title
                                )}"
                                class="work-section-image"
                                loading="lazy"
                            >


                            <div
                                class="work-section-overlay"
                            ></div>


                            <div
                                class="work-section-number"
                            >
                                ${String(index + 1).padStart(2, "0")}
                            </div>


                            <div
                                class="work-section-content"
                            >

                                <h3>
                                    ${escapeHtml(
                                        section.title
                                    )}
                                </h3>


                                <p>
                                    ${escapeHtml(
                                        section.shortDescription || ""
                                    )}
                                </p>


                                <div
                                    class="work-section-link"
                                >

                                    عرض الأعمال

                                    <span
                                        class="work-section-link-arrow"
                                    >
                                        ←
                                    </span>

                                </div>

                            </div>

                        </a>

                    `;

                }
            ).join("");


    } catch (error) {

        console.error(
            "Work sections error:",
            error
        );

        grid.innerHTML = "";

    }

}


function escapeHtml(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }


    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );
}
</script>
